<!DOCTYPE html>
<%
is_home = home?(@item)
# small trick to identify the favorite toggle in last readings page (to allow filtering favorites)
special_favorite_filter_id_attr = 'id="only-favorites"' if @item.identifier =~ '/last-readings.*'
%>
<html lang="<%= @config[:site][:lang] %>" <%= special_favorite_filter_id_attr %>>
<head>
  <meta charset="utf-8">
  <title><%= page_title(@item) %> &mdash; <%= @config[:site][:title] %></title>

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta name="theme-color" content="#f2f2f2">

  <link rel="expect" blocking="render" href="#content">
  <link rel="expect" blocking="render" href="#header">

  <script type="speculationrules">
    {
      "prerender": [{
        "source": "document",
        "where": {
          "href_matches": "/book/*"
        },
        "eagerness": "moderate"
      }]
    }
  </script>
  <% if book?(@item) %>
  <script src="<%= @items['/static/share-book-button.*'].path %>" defer></script>
  <% end %>
  <script src="<%= @items['/static/view-transition.*'].path %>" defer></script>
<% if is_home %>
  <link rel="preload" href="https://unpkg.com/tabulator-tables/dist/css/tabulator_semanticui.min.css" as="style" onload="this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables/dist/css/tabulator_semanticui.min.css">
  </noscript>
  <script type="text/javascript" src="https://unpkg.com/tabulator-tables/dist/js/tabulator.min.js" defer></script>
<% end %>

<% if @config[:dev] %>
  <link rel="stylesheet" type="text/css" href="<%= @items['/static/style.*'].path %>">
<% else %>
  <style type="text/css"><%= @items['/static/style.*'].compiled_content %></style>
<% end %>

  <%# One icon link, and deliberately no `<link>` for `/favicon.ico`: browsers disagree about which of several icon links to use and Chrome takes the last suitable one, so declaring the raster made it win the tab while the rounded SVG beside it sat there unread. The .ico is still built and still served at the site root, for the convention request a browser makes when a page declares nothing. %>
  <link rel="icon" type="image/svg+xml" href="<%= @items['/static/favicon.svg'].path %>">
  <%# iOS composites the home-screen icon itself, so it gets the full-bleed ground: it supplies the shape, and a shape in the file would be cut by it. Same 180px raster and same artwork as the book nook app's apple-touch icon. %>
  <link rel="apple-touch-icon" href="<%= @items['/static/apple-touch-icon-180x180.*'].path %>">

  <%# https://developer.chrome.com/multidevice/android/installtohomescreen %>
  <link rel="manifest" href="<%= @items['/manifest.*'].path %>">
  <meta name="mobile-web-app-capable" content="yes">

  <link rel="canonical" href="<%= "#{@config[:site][:url]}#{@item.path}" %>">

  <link rel="feed" type="application/atom+xml" title="Atom feed" href="<%= @items['/feed.*'].path %>">

  <!-- Open Graph Protocol (https://ogp.me/) -->
  <meta property="og:locale" content="<%= @config[:site][:lang] %>">
  <meta property="og:site_name" content="<%= @config[:site][:title] %>">
  <meta property="og:title" content="<%= page_title(@item) %>">
  <meta property="og:url" content="<%= "#{@config[:site][:url]}#{@item.path}" %>">

<% case when is_home %>
<%= render '/head_home.*' %>
<% when book?(@item) %>
<%= render '/head_book.*' %>
<% end %>

  <meta name="generator" content="Nanoc <%= Nanoc::VERSION %>">
</head>

<%
avatar = @items['/static/avatar.*']
avatar_repr = is_home ? :default : :compact
avatar_size = @config[:avatar_size][avatar_repr]
%>
<body>
<div id="main" class="<%= is_home ? 'full' : 'compact' %>">
  <div id="header">
    <div class="profile-picture">
    <% unless is_home %>
      <a href="<%= @items['/index.*'].path %>" title="Retour à l'accueil…">
    <% end %>
        <img src="<%= avatar.path(rep: avatar_repr) %>" width="<%= avatar_size %>" height="<%= avatar_size %>" alt="">
    <% unless is_home %>
      </a>
    <% end %>
    </div>

    <div class="header-detail">
      <div id="badges">
        <div>
          <div class="book-query-box">
            <%= lucide_icon_svg('search', params: { class: 'input-icon' }) %>
            <input type="search" autocomplete="off" id="book-search" placeholder="Rechercher…">
          </div>
          <ul class="search-results"></ul>
        </div>

      <% @config[:social][:badges].each do |key, social| %>
        <% icon_item = @items[social[:icon_identifier]] %>
        <div id="social-badge-<%= key %>" class="social-badge">
          <%#
          A bit hacky, but unfortunately, background-color: attr(data-tint color) won't work.
          Should have been: data-tint="#FFF000" + a[data-tint]:hover { background-color: attr(data-tint color[, fallback]); }
          Providing the color as a CSS variable would work though…
          So, final result is: style="--social-tint-color: #FFF000" + a:hover { background-color: var(--social-tint-color[, fallback]); }
          See https://css-tricks.com/css-attr-function-got-nothin-custom-properties/
          %>
          <a href="<%= "#{social[:base_url]}#{social[:self_page_path]}" %>" title="<%= social[:self_page_label] %>" style="--social-tint-color: <%= hex_color_to_rgba(social[:tint], opacity: 0.2) %>">
            <% if icon_item[:extension] == 'svg' %>
            <%= icon_svg(icon_item) %>
            <% else %>
            <img src="<%= icon_item.path %>" width="<%= @config[:social][:badge_size] %>" height="<%= @config[:social][:badge_size] %>" alt="<%= social[:label] %>">
            <% end %>
          </a>
        </div>
      <% end %>
      </div>
    </div>
  </div>

  <div id="content">
  <%= yield %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.1.0" defer></script>
<script src="<%= @items['/static/search.*'].path %>" defer></script>
</body>
</html>
