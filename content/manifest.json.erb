---
layout: none
---
{
  "name": <%= "#{@config[:site][:title]} — #{@config[:site][:description]}".to_json %>,
  "short_name": <%= @config[:site][:title].to_json %>,
  "icons": [
    {
      "src": "<%= @items['/static/pwa-64x64.*'].path %>",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "<%= @items['/static/pwa-192x192.*'].path %>",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "<%= @items['/static/pwa-512x512.*'].path %>",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "<%= @items['/static/maskable-icon-512x512.*'].path %>",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "background_color": "#f2f2f2",
  "theme_color": "#f2f2f2",
  "start_url": "/?utm_source=pwa",
  "display": "standalone",
  "orientation": "portrait",
  "description": "<%= @config[:site][:description] %>",
  "screenshots" : <%= @items.find_all('/static/pwa-screenshot-*').map { |item| pwa_screenshot_to_json(item) }.to_json %>
}
