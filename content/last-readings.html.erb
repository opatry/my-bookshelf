---
title: Dernières lectures
uuid: f7892c5d-a6a4-4e59-a7df-6838c73120c7
---

<%
books = last_books
if books.empty?
%>
  <h1>Lectures récentes</h1>
  <p>Aucune information sur les dernières lectures.</p>
<%
else
  books_by_year = books.group_by { |book| book[:read_date].year }
  books_by_year.each do |year, books_in_year|
    books_by_year[year] = books_in_year.group_by { |book| book[:read_date].month }
  end
  max_book_count_per_month = books_by_year.values.flat_map { |books_by_month| books_by_month.values.map(&:size) }.max.to_i
%>
  <h1><%= @item[:title] %> <span class="title-more"><a href="#" title="Pas de filtre">tout</a> • <a href="#only-favorites" title="Ne voir que les favoris"><%= heart_svg(size: 12) %></a></span></h1>

  <table class="calendar">
  <thead>
    <tr>
    <th></th>
    <% (1..12).each do |month_num| %>
      <th><%= I18n.t('date.month_names')[month_num].slice(0, 3) %></th>
    <% end %>
    <th></th>
    </tr>
  </thead>
  <tbody>
  <%
  books_by_year.each do |year, books_by_month|
    book_count_in_year = books_by_month.values.sum(&:size)
    book_count_in_year_title = I18n.t(
        'last_readings.readings_count_in_year',
        count: book_count_in_year,
        book_count: book_count_in_year,
        year: year
      )
  %>
  <tr>
    <%# FIXME handle case of empty years %>
    <th><a href="#y<%= year %>" title="<%= book_count_in_year_title %>"><%= year %></a></th>
    <%
    (1..12).each do |month_num|
      month_books = books_by_month[month_num] || []
      book_count = month_books.count
      book_count_title = I18n.t(
        'last_readings.readings_count_in_month',
        count: book_count,
        book_count: book_count,
        month: I18n.t('date.month_names')[month_num],
        year: year
      )
      # proportional level 0..7 normalized by the busiest month in the library (7 matches
      # `data-book-read-count` steps in style.css): keeps 1-book months small, and adapts
      # instead of saturating if a month ever goes above the historical peak of 7 books
      max_level = 7
      max_radius = 50
      book_level = (book_count * max_level.to_f / max_book_count_per_month).round
      radius_per_level = max_radius / max_level.to_f
      book_radius = radius_per_level * book_level
      # linked to values in style.css (`data-book-read-count`)
      book_color_alpha = book_level * 14 / 100.0
    %>
    <td class="calendar-cell" data-book-read-count="<%= book_level %>">
    <% if book_count > 0 %>
    <a href="#y<%= year %>-m<%= month_num %>" title="<%= book_count_title %>">
    <% end %>
      <svg height="100%" viewBox="0 0 100 100" class="book-read-count-marker">
        <circle cx="50" cy="50" r="<%= book_radius %>" fill="rgba(197, 17, 4, <%= book_color_alpha %>)" />
      </svg>
    <% if book_count > 0 %>
    </a>
    <% end %>
    </td>
    <% end %>
    <td class="calendar-cell">
    <a href="<%= @items[calendar_year_item_identifier(year)].path %>" title="Voir le calendrier des lectures de <%= year %>">
      <%= lucide_icon_svg('calendar-days', params: { size: 16, class: 'icon' }) %>
    </a>
    </td>
  </tr>
<% end %>
  </tbody>
  </table>

<%
books_by_year.each do |year, books_by_month|
  book_count_in_year = books_by_month.values.sum(&:size)
  book_count_in_year_label = I18n.t('last_readings.books_count', count: book_count_in_year)
  page_count_in_year = books_by_month.values.flatten.sum { |book| book[:page_count] || 0 }
  page_count_in_year_label = I18n.t(
    'last_readings.pages_count',
    count: page_count_in_year,
    formatted_count: ActiveSupport::NumberHelper::number_to_delimited(page_count_in_year, delimiter: I18n.t('number.format.delimiter'))
  )
%>
<div id="y<%= year %>" class="temporal-section year-section">
  <h2><%= year %>&nbsp;<span class="book-count">(<%= book_count_in_year_label %>, <%= page_count_in_year_label %>)</span></h2>
  <%
  books_by_month.each do |month_num, books_in_month|
    book_count_in_month = books_in_month.size
    book_count_in_month_label = I18n.t('last_readings.books_count', count: book_count_in_month)
    page_count_in_month = books_in_month.sum { |book| book[:page_count] || 0 }
    page_count_in_month_label = I18n.t(
      'last_readings.pages_count',
      count: page_count_in_month,
      formatted_count: ActiveSupport::NumberHelper::number_to_delimited(page_count_in_month, delimiter: I18n.t('number.format.delimiter'))
    )
  %>
  <div id="y<%= year %>-m<%= month_num %>" class="temporal-section month-section">
    <h3><%= I18n.t('date.month_names')[month_num].capitalize %>&nbsp;<span class="book-count">(<%= book_count_in_month_label %>, <%= page_count_in_month_label %>)</span> <span class="title-more"><a href="#" title="Retour en haut de page">↑</a></span></h3>
    <div id="recent-books" class="book-grid">
      <% books_in_month.each do |book| %>
        <%= book.reps[:card].compiled_content(snapshot: :card) %>
      <% end %>
    </div>
  </div>
  <% end %>
</div>
<% end %>
<% end %>