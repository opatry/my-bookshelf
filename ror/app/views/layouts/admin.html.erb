<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f2f2f2">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="shortcut icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <div id="main" class="compact">
      <div id="header">
        <div class="header-detail">
          <nav class="admin-nav" aria-label="<%= t('admin.nav.label') %>">
            <%= link_to t("admin.brand"), admin_root_path %>
            <span class="admin-nav__sep" aria-hidden="true">·</span>
            <%= link_to t("admin.nav.dashboard"), admin_root_path %>
            <%= link_to t("admin.nav.books"), admin_books_path %>
            <%= link_to t("admin.nav.tags"), admin_tags_path %>
            <%= link_to t("admin.nav.series"), admin_series_index_path %>
          </nav>
          <div id="badges">
            <div id="admin-public-site" class="social-badge">
              <%= link_to t("admin.nav.public_site"), root_path %>
            </div>
          </div>
        </div>
      </div>

      <div id="content">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>