<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="alternate" type="application/atom+xml" title="<%= t('site.name') %>" href="<%= feed_path(format: :xml) %>">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to t("site.name"), root_path, class: "site-header__brand" %>
        <nav class="site-header__nav" aria-label="<%= t('nav.label') %>">
          <%= nav_links %>
        </nav>
        <%= render "shared/search" %>
      </div>
    </header>

    <main class="site-main">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <p><%= t("site.footer_html", year: Time.current.year, site: link_to(t("site.name"), root_path)).html_safe %></p>
    </footer>
  </body>
</html>