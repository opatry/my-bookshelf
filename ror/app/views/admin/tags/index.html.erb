<% content_for(:title, t(".title")) %>

<div class="page-heading">
  <h1><%= t(".title") %> <%= link_to t(".new"), new_admin_tag_path, class: "button button--small" %></h1>
</div>

<% if @tags.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th><%= t(".th_name") %></th>
        <th><%= t(".th_slug") %></th>
        <th><%= t(".th_books") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tags.each do |tag| %>
        <tr>
          <td><%= link_to tag.name, edit_admin_tag_path(tag) %></td>
          <td class="muted"><%= tag.slug %></td>
          <td class="muted"><%= tag.books.count %></td>
          <td class="adminTable__actions">
            <%= link_to t("admin.actions.edit"), edit_admin_tag_path(tag) %>
            <%= button_to t("admin.actions.delete"), admin_tag_path(tag), method: :delete, data: { confirm: t("admin.confirm_tag_destroy") } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t(".empty") %></p>
<% end %>