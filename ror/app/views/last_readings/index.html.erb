<% content_for(:title, t(".title")) %>

<h1><%= t(".title") %></h1>

<% if @reviews.any? %>
  <% @reviews.group_by { |review| review.read_date.year }.each do |year, reviews| %>
    <h2><%= year %> <span class="book-count">(<%= t("home.section_library") %>)</span></h2>
    <%= render "shared/book_grid", reviews: reviews %>
  <% end %>
<% else %>
  <p class="empty-state"><%= t("home.empty") %></p>
<% end %>