<% content_for(:title, t(".title")) %>

<div class="page-heading">
  <h1><%= t(".title") %></h1>
  <p class="subtitle"><%= t(".subtitle") %></p>
</div>

<% if @reviews.any? %>
  <% @reviews.group_by { |review| review.read_date.year }.each do |year, reviews| %>
    <section class="home-section">
      <h2><%= year %></h2>
      <%= render "shared/book_grid", reviews: reviews, with_date: true %>
    </section>
  <% end %>
<% else %>
  <p class="empty-state"><%= t("home.empty") %></p>
<% end %>