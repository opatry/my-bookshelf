<div>
  <div class="book-query-box" data-search data-empty-message="<%= t('search.no_results') %>">
    <%= search_icon %>
    <label class="visually-hidden" for="search-input"><%= t("search.label") %></label>
    <input type="search" id="search-input" class="search__input"
           placeholder="<%= t('search.placeholder') %>" autocomplete="off"
           data-search-input>
  </div>
  <ul class="search-results" data-search-results role="listbox"></ul>
</div>