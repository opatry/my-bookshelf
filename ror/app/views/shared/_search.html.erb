<div class="search" data-search data-empty-message="<%= t('search.no_results') %>">
  <label class="visually-hidden" for="search-input"><%= t("search.label") %></label>
  <input type="search" id="search-input" class="search__input"
         placeholder="<%= t('search.placeholder') %>" autocomplete="off"
         data-search-input>
  <ul class="search__results" data-search-results role="listbox"></ul>
</div>