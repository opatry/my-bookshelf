<% content_for(:title, t(".title")) %>

<h1><%= t(".title") %></h1>

<% if @reviews.any? %>
  <div class="book-grid wishlist-page">
    <% @reviews.each do |review| %>
      <%= render "shared/book_card", review: review %>
    <% end %>
  </div>
<% else %>
  <p class="empty-state"><%= t("home.empty") %></p>
<% end %>