<% content_for(:title, t(".title", title: @book.title, author: @book.author)) %>

<% content_for(:og_type, "book") %>
<% content_for(:og_description, book_og_description(@book)) %>
<% content_for(:head) do %>
  <meta property="book:author" content="<%= @book.author %>">
  <% if @book.isbn.present? %>
    <meta property="book:isbn" content="<%= @book.isbn %>">
  <% end %>
  <% if @book.publication_year.present? %>
    <meta property="book:release_date" content="<%= @book.publication_year %>">
  <% end %>
  <% @book.tags.each do |tag| %>
    <meta property="book:tag" content="<%= tag.name %>">
  <% end %>
  <% if @book.cover.attached? %>
    <meta property="og:image" content="<%= url_for(@book.cover.variant(:default)) %>">
    <meta property="og:image:secure_url" content="<%= url_for(@book.cover.variant(:default)) %>">
    <meta property="og:image:type" content="<%= @book.cover.blob.content_type %>">
  <% end %>
<% end %>

<div id="book-<%= @book.isbn %>">
  <h2 class="book-title">
    <%= @book.title %>
    <% if @review&.favorite %>
      <span class="favorite-icon" aria-label="<%= t('meta.favorite') %>" title="<%= t('meta.favorite') %>"><%= heart_icon %></span>
    <% end %>
  </h2>
  <h4 class="book-detail__author"><%= @book.author %></h4>

  <% if @review&.read? %>
    <%= star_rating(@review, size: 16) %>
  <% end %>

  <% metadata = book_metadata(@book, @review) %>
  <% unless metadata.empty? %>
    <p class="book-details"><%= metadata.join(", ").html_safe %></p>
  <% end %>

  <%= cover_tag(@book, variant: :default, class: "book-cover") %>

  <% if @book.description.present? %>
    <div class="book-detail__description"><%= simple_format(@book.description) %></div>
  <% else %>
    <p class="book-detail__none"><%= t(".no_meta") %></p>
  <% end %>

  <div style="clear: left; margin-bottom: 1em;"></div>

  <%= render "shared/tags", tags: @book.tags_in_order %>

  <% if @same_series.any? %>
    <h3><%= t(".same_series", series: @book.series.name) %></h3>
    <ul class="linked-books">
      <% @same_series.each do |book| %>
        <li><%= link_to "#{book.title}, par #{book.author}", book_path(book) %></li>
      <% end %>
    </ul>
  <% end %>
</div>